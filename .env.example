# Telegram Bot Token von @BotFather
TELEGRAM_BOT_TOKEN=your-token-here

# Home Assistant Long-Lived Access Token
# Erstellen unter: http://<ip>:8123/profile/security → Long-Lived Access Tokens
HA_TOKEN=your-ha-token-here

# LLM-Provider: "ollama" (lokal, Default) oder "anthropic" (Claude API)
# ollama = alles läuft lokal auf dem Mac, keine Daten verlassen das Gerät
# anthropic = Claude API (Prompts gehen an Anthropic!), braucht ANTHROPIC_API_KEY
# LLM_PROVIDER=ollama

# Claude API Key (nur bei LLM_PROVIDER=anthropic nötig)
# WICHTIG: das ist der API-Key aus der Anthropic Console (console.anthropic.com),
# NICHT das Claude-Pro/Max-Abo. Das Abo funktioniert hier nicht.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxx

# LLM Modell für den Agent (Text + Tool-Calling + Vision)
# --- Bei LLM_PROVIDER=ollama ---
# Qwen3.8:27b ist multimodal — versteht Text UND Bilder, gutes Agentic-Verhalten
# Für 48GB RAM: qwen3.8:27b (empfohlen, ein Modell für alles)
# Alternativen: qwen3:32b (nur Text), qwen3:8b (leicht)
# --- Bei LLM_PROVIDER=anthropic (alle multimodal) ---
# claude-sonnet-5 (empfohlen, guter Speed/Preis), claude-opus-5 (stärker, teurer),
# claude-haiku-4.5 (schnellstes/günstigstes)
# PI_MODEL=qwen3.8:27b

# Bildanalyse (Telegram-Fotos) braucht KEIN eigenes Modell mehr:
# Das multimodale PI_MODEL (qwen3.8:27b bzw. Claude) verarbeitet Bilder direkt über /prompt.

# Thinking-Level für qwen3.8 (off, minimal, low, medium, high, xhigh, max)
# medium empfohlen — "high"+ führt zu Overthinking bei einfachen Befehlen
# THINKING_LEVEL=low

# Wetter-Standort als "latitude,longitude" (optional, default: 52.52,13.405 = Berlin)
# Koordinaten z.B. über Google Maps ermitteln
# WEATHER_LOCATION=52.52,13.405

# TTS/STT Service URL für Telegram Voice Messages
# hey-ribo.py läuft nativ auf dem Mac und stellt TTS/STT bereit
# RIBO_URL=http://host.docker.internal:8085

# Tavily API Key für Web-Suche (optional — ohne Key ist das search-Tool deaktiviert)
# Kostenlos registrieren: https://tavily.com
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxx

# Bildgenerierung (optional — FLUX auf Apple Silicon via mflux)
# Service-URL (default: http://host.docker.internal:8086)
# IMAGEGEN_SERVICE_URL=http://host.docker.internal:8086
# Modell: "schnell" (4 Steps, schnell) oder "dev" (20 Steps, beste Qualität)
# IMAGEGEN_MODEL=schnell
# Quantisierung: 4 oder 8 Bit (spart RAM, 8 empfohlen)
# IMAGEGEN_QUANTIZE=8

# Erzeugen mit python3 scripts/setup-security.py; Werte niemals einchecken.
RIBO_WEB_USER=enrico
RIBO_WEB_PASSWORD=
RIBO_INTERNAL_TOKEN=

# MQTT-Clients: Erzeugen mit setup-security.py; Hashdatei mit setup-mqtt.py.
GOVEE_MQTT_USER=ribo
GOVEE_MQTT_PASSWORD=

# Flux2 text model reuse (one worker, idle timeout releases GPU memory)
IMAGEGEN_REUSE_MODEL=1
IMAGEGEN_MODEL_IDLE_SECONDS=60

# Maximum generated tokens per model call, including thinking where the model counts it
RIBO_MAX_OUTPUT_TOKENS=8192
